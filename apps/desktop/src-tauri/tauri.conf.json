{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folyvo",
  "version": "0.0.1",
  "identifier": "dev.folyvo.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build && bash finder/build.sh"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "macOS": {
      "files": {
        "PlugIns/FolyvoFinderSync.appex": "../finder/build/FolyvoFinderSync.appex"
      },
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFQzQ3M0U5MjE4NzA3NUIKUldSYkI0Y2g2WFBFenY0UXIvTzBlZ1J2WDdxQ2laeXVqQlJNK0xxU3Z2TjFoWFYyd1NkNE1PZzMK",
      "endpoints": [
        "https://github.com/bilalyazicioglu/Folyvo/releases/latest/download/latest.json"
      ]
    }
  }
}
