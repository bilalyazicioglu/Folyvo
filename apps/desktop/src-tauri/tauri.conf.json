{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folyvo",
  "version": "0.1.0",
  "identifier": "dev.folyvo.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.png"], "category": "Productivity" }
}
